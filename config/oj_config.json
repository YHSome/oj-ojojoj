{
  "api": {
    "base": "http://tinywebdb.appinventor.space/api",
    "base_https": "https://tinywebdb.appinventor.space/api",
    "browse": "https://tinywebdb.appinventor.space/webdb-你的实例编号",
    "user": "YOUR_USER",
    "secret": "YOUR_SECRET",
    "timeout_s": 15,
    "retries": 5,
    "min_interval_s": 0.45,
    "search_page_size": 100,
    "search_max_pages": 20,
    "value_chunk_chars": 8000
  },
  "crypto": {
    "enabled": true,
    "scheme": "RSA-OAEP-256",
    "key_bits": 2048,
    "private_key": "",
    "require_encrypted": false,
    "seal_results": true,
    "include_source": true
  },
  "judge": {
    "id": "HOST-D-OJ-01",
    "display_name": "本机判题机 (D:\\OJ)",
    "public_case_detail": false,
    "public_stderr": true,
    "share_mode": "auto",
    "adapt_rate_limit": true,
    "claim_min_prob": 0.08,
    "cluster_ttl_s": 45,
    "cluster_cache_s": 5.0,
    "lease_renew_ratio": 0.4,
    "workers": 4,
    "poll_interval_s": 2.0,
    "queue_refresh_interval_s": 3.0,
    "batch_user_stats": true,
    "prob_cache_ttl_s": 120,
    "cmd_poll_interval_s": 3.0,
    "rank_interval_s": 120.0,
    "publish_interval_s": 2.0,
    "publish_min_gap_s": 3.0,
    "heartbeat_interval_s": 20.0,
    "maint_interval_s": 300.0,
    "lock_ttl_s": 180,
    "lock_jitter_ms": [
      150,
      400
    ],
    "seen_max": 5000,
    "recover_on_start": true,
    "lease_seconds": 180,
    "archive_ttl_h": 24,
    "archive_keep_cases": false,
    "session_ttl_h": 72,
    "rejudge_max_age_h": 168
  },
  "limits": {
    "compile_timeout_ms": 15000,
    "compile_log_max_bytes": 8192,
    "default_time_limit_ms": 1000,
    "default_memory_limit_kb": 262144,
    "default_output_limit_kb": 8192,
    "stderr_limit_kb": 64,
    "retry_max_attempts": 3,
    "kill_grace_ms": 500,
    "mem_sample_ms": 20,
    "isolate": {
      "job_object": true,
      "active_process_limit": 8,
      "kill_on_close": true,
      "compile_job_object": false
    }
  },
  "languages": {
    "cpp": {
      "name": "C++17",
      "ext": "cpp",
      "compile": [
        "g++",
        "-O2",
        "-std=c++17",
        "-static",
        "-o",
        "{exe}",
        "{src}"
      ],
      "run": [
        "{exe}"
      ],
      "interpreted": false,
      "time_factor": 1,
      "enabled": true
    },
    "c": {
      "name": "C11",
      "ext": "c",
      "compile": [
        "gcc",
        "-O2",
        "-std=c11",
        "-static",
        "-o",
        "{exe}",
        "{src}"
      ],
      "run": [
        "{exe}"
      ],
      "interpreted": false,
      "time_factor": 1,
      "enabled": true
    },
    "py": {
      "name": "Python 3",
      "ext": "py",
      "compile": [],
      "run": [
        "python",
        "-X",
        "utf8",
        "{src}"
      ],
      "interpreted": true,
      "time_factor": 2,
      "enabled": true
    },
    "java": {
      "name": "Java",
      "ext": "java",
      "compile": [
        "javac",
        "-encoding",
        "UTF-8",
        "-d",
        "{outdir}",
        "{src}"
      ],
      "run": [
        "java",
        "-cp",
        "{outdir}",
        "Main"
      ],
      "interpreted": false,
      "time_factor": 2,
      "enabled": false
    },
    "pas": {
      "name": "Pascal",
      "ext": "pas",
      "compile": [
        "fpc",
        "-O2",
        "-o{exe}",
        "{src}"
      ],
      "run": [
        "{exe}"
      ],
      "interpreted": false,
      "time_factor": 1,
      "enabled": false
    }
  },
  "languages_alias": {
    "cpp17": "cpp",
    "c++17": "cpp",
    "c17": "c",
    "c11": "c",
    "python3": "py",
    "python": "py",
    "java21": "java",
    "pascal": "pas"
  },
  "checker": {
    "default": "tokens",
    "float_eps": 1e-06,
    "float_relative_eps": 0,
    "alias": {
      "diff": "tokens",
      "strict": "exact",
      "spj": "custom"
    }
  },
  "paths": {
    "root": "",
    "data": "",
    "problems": "",
    "work": "",
    "cache": "",
    "state": "",
    "logs": "",
    "tmp": "",
    "python": "",
    "toolchain_dirs": []
  },
  "log": {
    "level": "INFO"
  },
  "auth": {
    "salt_len": 12,
    "password_min_len": 4,
    "default_admin": "admin",
    "admin_token_ttl_h": 12,
    "admin_key": ""
  },
  "schema": "oj-ojojoj/1.0"
}