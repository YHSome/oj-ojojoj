# ============================================================
#  运行数据 / 隐私 / 密钥 —— 绝对不要提交
#  （注意：.gitignore 不支持行尾注释，注释必须单独成行）
# ============================================================

# 每次判题的工作目录（含选手源码）
data/work/

# 题目与测试点缓存（含测试数据明文）
data/cache/

# 判题机私钥 judge_key.json、锁文件、备份快照、测试账号
data/state/

# 编译器临时目录
data/tmp/

# 判题日志
logs/
*.log

# 自检脚本留下的临时目录
ojcheck_*/

# 本机私密配置（仓库里只有 *.example.* 占位版）
config/oj_config.local.json
frontend/assets/config.js
*.local.json

# ============================================================
#  体积巨大的外部运行时（自行下载，见 CREDITS.md）
# ============================================================
tools/w64devkit/
tools/git-portable/
tools/git-tar/
tools/dist/
dist/
third_party/

# ============================================================
#  Python / 编辑器 / 系统
# ============================================================
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
desktop.ini
